{
  "name": "phaser3-typescript-webpack",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "author": "troyedwardsjr",
  "main": "index.js",
  "scripts": {
    "atlases": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/pack-atlases.ps1",
    "atlases:test": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/pack-atlases.ps1 -AtlasesDir .atlas-check\\atlases -ManifestPath .atlas-check\\atlasManifest.ts",
    "prebuild": "npm run localization:sync && npm run atlases",
    "build": "webpack --config webpack.production.config.js",
    "prestart": "npm run localization:sync && npm run atlases",
    "start": "webpack",
    "predev": "npm run localization:sync && npm run atlases",
    "dev": "webpack",
    "predev:no-atlases": "npm run localization:sync",
    "dev:no-atlases": "webpack",
    "devNoArt": "npm run dev:no-atlases",
    "predeploy": "npm run localization:sync && npm run atlases",
    "deploy": "webpack --config webpack.production.config.js",
    "bitmap-fonts": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/update-bitmap-fonts.ps1",
    "localization:sync": "node tools/sync-localization-entries.js"
  },
  "license": "Private",
  "devDependencies": {
    "@babel/core": "^7.0.0-rc.2",
    "@babel/plugin-proposal-class-properties": "^7.0.0-rc.2",
    "@babel/polyfill": "^7.0.0-rc.2",
    "@babel/preset-env": "^7.0.0-rc.2",
    "@babel/preset-typescript": "^7.0.0-rc.2",
    "awesome-typescript-loader": "^3.4.1",
    "babel-loader": "8.0.0-beta.2",
    "browser-sync": "^2.18.13",
    "browser-sync-webpack-plugin": "^1.2.0",
    "html-webpack-plugin": "^2.30.1",
    "raw-loader": "^0.5.1",
    "typescript": "^2.7.2",
    "webpack": "3.11.0",
    "expose-loader": "^0.7.5"
  },
  "dependencies": {
    "gameanalytics": "4.0.5",
    "phaser-ce": "2.13.1",
    "phaser-kinetic-scrolling-plugin": "1.2.1",
    "phaser-nineslice": "1.1.3",
    "uglifyjs-webpack-plugin": "^2.2.0"
  }
}
